# ─────────────────────────────────────────────
# ITAM Portal — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#
# Backend vars are hardcoded in api_server.py / auth_service.py.
# Edit those files directly or refactor to read from this .env.
# ─────────────────────────────────────────────

# ── Backend (api_server.py / auth_service.py) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
AGENT_SECRET_TOKEN=key_prod_win_agent_d43f721a  # Must match agent_token in agent config

# ── Frontend (asset-dashboard/.env) ──
VITE_API_URL=https://asset-management-gciq.onrender.com
VITE_SUPABASE_URL=https://wvxvwzjqhxymawddawey.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_APP_TITLE=ITAM Portal
VITE_POLL_INTERVAL_MS=3000

# ── Agent (asset-agent/config/config.json) ──
# Edit config.json directly — not read from env.
# AGENT_API_URL=http://your-server-ip:8000
# AGENT_TOKEN=your-agent-token
